//@version=6
// =====================================================================
//  Sperandeo 3 & 2B  —  Strategy (백테스트 버전)
// ---------------------------------------------------------------------
//  인디케이터 "Sperandeo 1-2-3 & 2B"의 신호를 그대로 사용하되,
//  ▶ 점3(추세전환 확정) 신호와 ▶ 2B 신호로 진입/청산하여 백테스트합니다.
//    - 매수: 하단 점3(상승전환) 또는 상승형 2B
//    - 매도: 상단 점3(하락전환) 또는 하락형 2B
//  신호는 봉 마감 시 확정(피벗 n봉 지연 → 룩어헤드 없음), 다음 봉 시가 체결.
//  주의: 재량적 개념의 근사치입니다. 기간(n)/시간프레임/수수료 가정에 따라 결과가 달라집니다.
// =====================================================================
strategy("Sperandeo 3 & 2B Strategy", overlay=true, max_labels_count=500, max_lines_count=100,
     initial_capital=10000000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.15, pyramiding=0, calc_on_every_tick=false)

// ---------------- Inputs ----------------
string gP  = "Pivot"
int    n   = input.int(5, "Pivot(프랙탈) 기간", minval=2, group=gP, tooltip="작을수록 민감. 3=매우 민감, 5=민감, 10=둔감")

string gBT = "백테스트 진입/청산"
bool   useP3   = input.bool(true,  "점3(추세전환) 신호로 매매", group=gBT)
bool   use2B   = input.bool(true,  "2B 신호로 매매", group=gBT)
string dirMode = input.string("롱only", "매매 방향", options=["롱only","숏only","롱&숏"], group=gBT)
string gEx = "청산 (구조적 손절 + ATR 트레일링)"
bool   useStop    = input.bool(true, "구조적 손절 + 트레일링 사용", group=gEx)
float  atrMult    = input.float(3.0, "트레일링 ATR 배수(샹들리에)", minval=0.5, step=0.5, group=gEx)
float  atrBuf     = input.float(0.5, "구조적 손절 ATR 버퍼", minval=0.0, step=0.1, group=gEx)
int    exitAtrLen = input.int(14, "청산 ATR 기간", minval=1, group=gEx)

string gTP = "고정 TP/SL"
bool   useTPSL = input.bool(false, "고정 익절/손절 사용", group=gTP, tooltip="진입가 기준 고정 % 익절/손절. 트레일링과 함께 켜면 손절은 둘 중 더 타이트한 쪽이 적용됨")
float  tpPerc  = input.float(3.0, "익절 %", minval=0.0, step=0.1, group=gTP)
float  slPerc  = input.float(2.0, "손절 %", minval=0.0, step=0.1, group=gTP)
bool   useDate = input.bool(false, "기간 제한", group=gBT)
int    fromDate= input.time(timestamp("2016-01-01T00:00"), "시작", group=gBT)
int    toDate  = input.time(timestamp("2027-01-01T00:00"), "종료", group=gBT)

string g2bf = "2B 신뢰도 필터"
bool  f2bVol   = input.bool(true,  "거래량 확인", group=g2bf)
float volMult  = input.float(1.5,  "  · 거래량 배수(×SMA)", minval=0.1, step=0.1, group=g2bf)
int   volLen   = input.int(10,     "  · 거래량 SMA 기간", minval=1, group=g2bf)
bool  f2bWick  = input.bool(true,  "ATR 거부 꼬리", group=g2bf)
float wickMult = input.float(1.0,  "  · 꼬리 ATR 배수", minval=0.1, step=0.1, group=g2bf)
bool  f2bFresh = input.bool(true,  "되돌림 N봉 이내", group=g2bf)
int   b2bMaxBars = input.int(5,    "  · 경신→되돌림 최대 봉수", minval=1, group=g2bf)
int   atrLen   = input.int(7,      "  · ATR 기간", minval=1, group=g2bf)

string gViz = "표시"
bool  show123 = input.bool(true,  "1-2-3 라벨", group=gViz)
int   setupExpireBars = input.int(30, "셋업 유효기간(봉)", minval=5, group=gViz)
float testTolMult = input.float(0.5, "점2 재시험 허용치(ATR배수)", minval=0.0, step=0.1, group=gViz, tooltip="점2가 1번 지지/저항을 이 ATR배수만큼 살짝 침범(스프링)해도 인정하고, 그 범위 안에선 무효화하지 않음. 0=엄격")
bool  show2b  = input.bool(true,  "2B 라벨", group=gViz)
bool  showTL  = input.bool(true,  "추세선", group=gViz)
color colTop  = input.color(color.red,   "하락(상단) 색", group=gViz)
color colBot  = input.color(color.green, "상승(하단) 색", group=gViz)
int   labelTransp = input.int(50, "라벨 투명도", minval=0, maxval=100, group=gViz)

// ---------------- Pivots ----------------
float ph = ta.pivothigh(n, n)
float pl = ta.pivotlow(n, n)

var float up1 = na
var int   up1x = na
var float up2 = na
var int   up2x = na
var float dn1 = na
var int   dn1x = na
var float dn2 = na
var int   dn2x = na

if not na(ph)
    up2 := up1
    up2x := up1x
    up1 := ph
    up1x := bar_index - n
if not na(pl)
    dn2 := dn1
    dn2x := dn1x
    dn1 := pl
    dn1x := bar_index - n

// ---------------- Trendlines (current) ----------------
float slope_dn = (not na(dn1) and not na(dn2) and dn1x != dn2x) ? (dn1 - dn2) / (dn1x - dn2x) : na
float slope_up = (not na(up1) and not na(up2) and up1x != up2x) ? (up1 - up2) / (up1x - up2x) : na
float y_dn = not na(slope_dn) ? dn1 + slope_dn * (bar_index - dn1x) : na
float y_up = not na(slope_up) ? up1 + slope_up * (bar_index - up1x) : na

var line lnDn = na
var line lnUp = na
if showTL
    if not na(y_dn)
        if na(lnDn)
            lnDn := line.new(dn2x, dn2, bar_index, y_dn, color=color.new(colBot, 30), width=1, style=line.style_dashed)
        else
            line.set_xy1(lnDn, dn2x, dn2)
            line.set_xy2(lnDn, bar_index, y_dn)
    if not na(y_up)
        if na(lnUp)
            lnUp := line.new(up2x, up2, bar_index, y_up, color=color.new(colTop, 30), width=1, style=line.style_dashed)
        else
            line.set_xy1(lnUp, up2x, up2)
            line.set_xy2(lnUp, bar_index, y_up)

// ---------------- Context / point-1 break ----------------
bool upCtx = not na(slope_dn) and slope_dn > 0
bool dnCtx = not na(slope_up) and slope_up < 0

// ta.crossunder/crossover는 매 봉 먼저 계산 (조건문 단락평가로 인한 이력 오류 방지)
bool crossUnderTrendSupport   = ta.crossunder(close, y_dn)
bool crossOverTrendResistance = ta.crossover(close, y_up)
bool brk1_top = upCtx and crossUnderTrendSupport
bool brk1_bot = dnCtx and crossOverTrendResistance

// ---------------- label helper ----------------
mk(int x, float y, string txt, bool below, color col) =>
    label.new(x, y, txt, style = below ? label.style_label_up : label.style_label_down, color = color.new(col, labelTransp), textcolor = color.white, size = size.small)

// 신호 플래그 (매 봉 초기화)
bool fireTop3 = false      // 상단 점3 (하락전환 확정)  → 매도
bool fireBot3 = false      // 하단 점3 (상승전환 확정)  → 매수
bool fire2Bbear = false    // 하락형 2B                 → 매도
bool fire2Bbull = false    // 상승형 2B                 → 매수

// 재시험 허용치 (ATR 기반) — 점2가 1번 레벨을 살짝 침범해도 인정하는 여유
float atrVal = ta.atr(atrLen)
float tol    = testTolMult * nz(atrVal)

// ================= 상단: 하락전환 1-2-3 =================
var int   topSt   = 0
var float topHigh = na
var float topLow  = na
var int   topStartBar = na

bool topLowBreak = ta.crossunder(close, topLow)

if show123
    // 셋업 유효기간 만료
    if topSt != 0 and not na(topStartBar) and bar_index - topStartBar > setupExpireBars
        topSt := 0
        topHigh := na
        topLow := na
        topStartBar := na
    // 무효화: 직전 고점 위로 신고점 (허용치 초과 시에만)
    if topSt != 0 and not na(topHigh) and high > topHigh + tol
        topSt := 0
        topHigh := na
        topLow := na
        topStartBar := na
    // 점 1
    if brk1_top and topSt == 0
        topSt := 1
        topHigh := up1
        topLow := na
        topStartBar := bar_index
        mk(bar_index, high, "1", false, colTop)
    // 점 2 (피벗이 점1 이후에 형성된 경우만 → 순서 보장)
    if topSt == 1 and not na(ph) and not na(topHigh) and ph < topHigh + tol and (bar_index - n) > topStartBar
        topSt := 2
        topLow := dn1
        mk(bar_index - n, ph, "2", false, colTop)
    // 점 3
    if topSt == 2 and not na(topLow) and topLowBreak
        topSt := 0
        mk(bar_index, high, "3", false, colTop)
        fireTop3 := true
        topHigh := na
        topLow := na
        topStartBar := na

// ================= 하단: 상승전환 1-2-3 =================
var int   botSt   = 0
var float botLow  = na
var float botHigh = na
var int   botStartBar = na

bool botHighBreak = ta.crossover(close, botHigh)

if show123
    // 셋업 유효기간 만료
    if botSt != 0 and not na(botStartBar) and bar_index - botStartBar > setupExpireBars
        botSt := 0
        botLow := na
        botHigh := na
        botStartBar := na
    // 무효화: 직전 저점 아래로 신저점 (허용치 초과 시에만)
    if botSt != 0 and not na(botLow) and low < botLow - tol
        botSt := 0
        botLow := na
        botHigh := na
        botStartBar := na
    // 점 1
    if brk1_bot and botSt == 0
        botSt := 1
        botLow := dn1
        botHigh := na
        botStartBar := bar_index
        mk(bar_index, low, "1", true, colBot)
    // 점 2 (피벗이 점1 이후에 형성된 경우만 → 순서 보장)
    if botSt == 1 and not na(pl) and not na(botLow) and pl > botLow - tol and (bar_index - n) > botStartBar
        botSt := 2
        botHigh := up1
        mk(bar_index - n, pl, "2", true, colBot)
    // 점 3
    if botSt == 2 and not na(botHigh) and botHighBreak
        botSt := 0
        mk(bar_index, low, "3", true, colBot)
        fireBot3 := true
        botLow := na
        botHigh := na
        botStartBar := na

// ================= 2B (신뢰도 필터: 거래량 · ATR 거부꼬리 · 되돌림 신속성) =================
float volSMA = ta.sma(nz(volume), volLen)

var float b2bTop = na
var bool  b2bTopX = false
var int   b2bTopXBar = na
var float b2bBot = na
var bool  b2bBotX = false
var int   b2bBotXBar = na
if show2b
    if not na(ph)
        b2bTop := ph
        b2bTopX := false
        b2bTopXBar := na
    if not na(b2bTop)
        if high > b2bTop and not b2bTopX
            b2bTopX := true
            b2bTopXBar := bar_index
        if b2bTopX and close < b2bTop
            bool volOK   = not f2bVol   or na(volSMA) or volSMA <= 0 or nz(volume) >= volMult * volSMA
            bool wickOK  = not f2bWick  or (high - math.max(open, close)) >= wickMult * atrVal
            bool freshOK = not f2bFresh or (not na(b2bTopXBar) and bar_index - b2bTopXBar <= b2bMaxBars)
            if volOK and wickOK and freshOK
                mk(bar_index, high, "2B", false, colTop)
                fire2Bbear := true
            b2bTopX := false
            b2bTop := na
            b2bTopXBar := na
    if not na(pl)
        b2bBot := pl
        b2bBotX := false
        b2bBotXBar := na
    if not na(b2bBot)
        if low < b2bBot and not b2bBotX
            b2bBotX := true
            b2bBotXBar := bar_index
        if b2bBotX and close > b2bBot
            bool volOK2   = not f2bVol   or na(volSMA) or volSMA <= 0 or nz(volume) >= volMult * volSMA
            bool wickOK2  = not f2bWick  or (math.min(open, close) - low) >= wickMult * atrVal
            bool freshOK2 = not f2bFresh or (not na(b2bBotXBar) and bar_index - b2bBotXBar <= b2bMaxBars)
            if volOK2 and wickOK2 and freshOK2
                mk(bar_index, low, "2B", true, colBot)
                fire2Bbull := true
            b2bBotX := false
            b2bBot := na
            b2bBotXBar := na

// ---------------------------------------------------------------------
//  전략 진입/청산
// ---------------------------------------------------------------------
bool bullSig = (useP3 and fireBot3) or (use2B and fire2Bbull)   // 매수 신호
bool bearSig = (useP3 and fireTop3) or (use2B and fire2Bbear)   // 매도 신호

bool inRange = not useDate or (time >= fromDate and time <= toDate)
bool longOK  = dirMode != "숏only"
bool shortOK = dirMode != "롱only"

if inRange
    if bullSig
        if longOK
            strategy.entry("Long", strategy.long)          // 롱&숏이면 숏 자동 청산 후 롱
        if not longOK
            strategy.close("Short")                        // 숏only: 매수신호=숏 청산
    if bearSig
        if shortOK
            strategy.entry("Short", strategy.short)         // 롱&숏이면 롱 자동 청산 후 숏
        if not shortOK
            strategy.close("Long")                          // 롱only: 매도신호=롱 청산

// ---------------------------------------------------------------------
//  청산: (A) 구조적 손절 + ATR 트레일링  +  (B) 고정 TP/SL  통합
//   - 손절선 = 활성화된 것 중 '더 타이트한' 쪽 (둘 다 켜면 max(롱)/min(숏))
//   - 익절 = 고정 TP(%) limit  (트레일링만 쓰면 익절 목표 없음)
//   - 반대 신호 청산은 위 진입 로직에서 유지(fallback)
// ---------------------------------------------------------------------
float exATR = ta.atr(exitAtrLen)
float ep = strategy.position_avg_price
var float longStructStop  = na
var float shortStructStop = na
var float posHi = na
var float posLo = na

// 진입 순간 구조적 손절/추적 초기화
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    longStructStop := (not na(dn1) ? dn1 : low) - atrBuf * exATR
    posHi := high
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    shortStructStop := (not na(up1) ? up1 : high) + atrBuf * exATR
    posLo := low

// 롱 청산
if strategy.position_size > 0
    posHi := math.max(nz(posHi, high), high)
    float sLvl = na
    if useStop
        float chandL = posHi - atrMult * exATR
        sLvl := math.max(nz(longStructStop, chandL), chandL)          // 구조적+트레일링
    if useTPSL and slPerc > 0
        float fixedSL = ep * (1 - slPerc / 100)
        sLvl := na(sLvl) ? fixedSL : math.max(sLvl, fixedSL)          // 둘 다면 더 타이트
    float tLvl = (useTPSL and tpPerc > 0) ? ep * (1 + tpPerc / 100) : na
    if not na(sLvl) or not na(tLvl)
        strategy.exit("Long Exit", from_entry="Long", stop = sLvl, limit = tLvl)
else
    longStructStop := na
    posHi := na

// 숏 청산
if strategy.position_size < 0
    posLo := math.min(nz(posLo, low), low)
    float sLvlS = na
    if useStop
        float chandS = posLo + atrMult * exATR
        sLvlS := math.min(nz(shortStructStop, chandS), chandS)
    if useTPSL and slPerc > 0
        float fixedSLS = ep * (1 + slPerc / 100)
        sLvlS := na(sLvlS) ? fixedSLS : math.min(sLvlS, fixedSLS)
    float tLvlS = (useTPSL and tpPerc > 0) ? ep * (1 - tpPerc / 100) : na
    if not na(sLvlS) or not na(tLvlS)
        strategy.exit("Short Exit", from_entry="Short", stop = sLvlS, limit = tLvlS)
else
    shortStructStop := na
    posLo := na

// 기간 종료 시 전체 청산
if useDate and time > toDate
    strategy.close_all()
