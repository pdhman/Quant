//@version=6
// =====================================================================
//  Victor Sperandeo 1-2-3 추세전환 규칙 + 2B 규칙
// ---------------------------------------------------------------------
//  참고: 빅터 스페란데오 「전설의 프로 트레이더 빅 2」 10장
//        - 1-2-3 규칙: ① 추세선 돌파  ② 직전 고점/저점 재시험 실패  ③ 반등 저점/고점 돌파
//        - 2B 규칙: 신고점(신저점) 경신 후 직전 고점(저점)을 되돌려 돌파하면 전환 신호
//  구현: 피벗(프랙탈) 기반 추세선/스윙 감지
// =====================================================================
indicator("Reversal 123_v2", overlay=true, max_labels_count=500, max_lines_count=100)

// ---------------- Inputs ----------------
string gP  = "Pivot"
int    n   = input.int(5, "Pivot(프랙탈) 기간", minval=2, group=gP, tooltip="작을수록 민감(작은 눌림도 피벗으로 잡고 확정 빠름). 3=매우 민감, 5=민감, 10=둔감")

string g123 = "1-2-3 규칙"
bool  show123 = input.bool(true,  "1-2-3 표시", group=g123)
color colTop  = input.color(color.red,   "하락전환(상단) 색", group=g123)
color colBot  = input.color(color.green, "상승전환(하단) 색", group=g123)
bool  showTL  = input.bool(true,  "추세선 표시", group=g123)

int setupExpireBars = input.int(30, "셋업 유효기간(봉)", minval=5, group=g123)

string g2b = "2B 규칙"
bool  show2b = input.bool(true, "2B 표시", group=g2b)

string g2bf = "2B 신뢰도 필터"
bool  f2bVol   = input.bool(true,  "거래량 확인", group=g2bf)
float volMult  = input.float(1.5,  "  · 거래량 배수(×SMA)", minval=0.1, step=0.1, group=g2bf)
int   volLen   = input.int(10,     "  · 거래량 SMA 기간", minval=1, group=g2bf)
bool  f2bWick  = input.bool(true,  "ATR 거부 꼬리", group=g2bf)
float wickMult = input.float(1.0,  "  · 꼬리 ATR 배수", minval=0.1, step=0.1, group=g2bf)
bool  f2bFresh = input.bool(true,  "되돌림 N봉 이내", group=g2bf)
int   b2bMaxBars = input.int(5,    "  · 경신→되돌림 최대 봉수", minval=1, group=g2bf)
int   atrLen   = input.int(7,      "  · ATR 기간", minval=1, group=g2bf)

int labelTransp = input.int(50, "라벨 투명도", minval=0, maxval=100, group=g123)

// ---------------- Pivots ----------------
float ph = ta.pivothigh(n, n)
float pl = ta.pivotlow(n, n)

var float up1 = na
var int   up1x = na
var float up2 = na
var int   up2x = na

var float dn1 = na
var int   dn1x = na
var float dn2 = na
var int   dn2x = na

if not na(ph)
    up2 := up1
    up2x := up1x
    up1 := ph
    up1x := bar_index - n

if not na(pl)
    dn2 := dn1
    dn2x := dn1x
    dn1 := pl
    dn1x := bar_index - n

// ---------------- Trendlines ----------------
// 상승 지지선: 최근 저점 2개 연결
// 하락 저항선: 최근 고점 2개 연결
float slope_dn = (not na(dn1) and not na(dn2) and dn1x != dn2x) ? (dn1 - dn2) / (dn1x - dn2x) : na
float slope_up = (not na(up1) and not na(up2) and up1x != up2x) ? (up1 - up2) / (up1x - up2x) : na

float y_dn = not na(slope_dn) ? dn1 + slope_dn * (bar_index - dn1x) : na
float y_up = not na(slope_up) ? up1 + slope_up * (bar_index - up1x) : na

var line lnDn = na
var line lnUp = na

if showTL
    if not na(y_dn)
        if na(lnDn)
            lnDn := line.new(
                 dn2x, dn2,
                 bar_index, y_dn,
                 color=color.new(colBot, 30),
                 width=1,
                 style=line.style_dashed
            )
        else
            line.set_xy1(lnDn, dn2x, dn2)
            line.set_xy2(lnDn, bar_index, y_dn)

    if not na(y_up)
        if na(lnUp)
            lnUp := line.new(
                 up2x, up2,
                 bar_index, y_up,
                 color=color.new(colTop, 30),
                 width=1,
                 style=line.style_dashed
            )
        else
            line.set_xy1(lnUp, up2x, up2)
            line.set_xy2(lnUp, bar_index, y_up)

// ---------------- Context / Point 1 Break ----------------
bool upCtx = not na(slope_dn) and slope_dn > 0
bool dnCtx = not na(slope_up) and slope_up < 0

// 중요: ta.crossunder / ta.crossover는 매 봉 먼저 계산
bool crossUnderTrendSupport = ta.crossunder(close, y_dn)
bool crossOverTrendResistance = ta.crossover(close, y_up)

// 점 1 조건
bool brk1_top = upCtx and crossUnderTrendSupport
bool brk1_bot = dnCtx and crossOverTrendResistance

// ---------------- Label Helper ----------------
mk(int x, float y, string txt, bool below, color col) =>
    label.new(
         x,
         y,
         txt,
         style = below ? label.style_label_up : label.style_label_down,
         color = color.new(col, labelTransp),
         textcolor = color.white,
         size = size.small
    )

// ---------------- Alert Flags ----------------
bool fireTop1 = false
bool fireTop3 = false
bool fireBot1 = false
bool fireBot3 = false
bool fire2Bbear = false
bool fire2Bbull = false

// ================= 상단: 하락전환 1-2-3 =================
var int   topSt   = 0
var float topHigh = na
var float topLow  = na
var int   topStartBar = na

// 중요: 점 3용 crossunder도 매 봉 먼저 계산
bool topLowBreak = ta.crossunder(close, topLow)

if show123
    // 셋업 유효기간 만료
    if topSt != 0 and not na(topStartBar) and bar_index - topStartBar > setupExpireBars
        topSt := 0
        topHigh := na
        topLow := na
        topStartBar := na

    // 무효화: 직전 고점 위로 신고점
    if topSt != 0 and not na(topHigh) and high > topHigh
        topSt := 0
        topHigh := na
        topLow := na
        topStartBar := na

    // 점 1: 상승추세선 하향 돌파
    if brk1_top and topSt == 0
        topSt := 1
        topHigh := up1
        topLow := na
        topStartBar := bar_index
        mk(bar_index, high, "1", false, colTop)
        fireTop1 := true

    // 점 2: 직전 고점 재시험 실패 (피벗이 점1 이후에 형성된 경우만 → 순서 보장)
    if topSt == 1 and not na(ph) and not na(topHigh) and ph < topHigh and (bar_index - n) > topStartBar
        topSt := 2
        topLow := dn1
        mk(bar_index - n, ph, "2", false, colTop)

    // 점 3: 반등 저점 하향 돌파
    if topSt == 2 and not na(topLow) and topLowBreak
        topSt := 0
        mk(bar_index, high, "3", false, colTop)
        fireTop3 := true
        topHigh := na
        topLow := na
        topStartBar := na

// ================= 하단: 상승전환 1-2-3 =================
var int   botSt   = 0
var float botLow  = na
var float botHigh = na
var int   botStartBar = na

// 중요: 점 3용 crossover도 매 봉 먼저 계산
bool botHighBreak = ta.crossover(close, botHigh)

if show123
    // 셋업 유효기간 만료
    if botSt != 0 and not na(botStartBar) and bar_index - botStartBar > setupExpireBars
        botSt := 0
        botLow := na
        botHigh := na
        botStartBar := na

    // 무효화: 직전 저점 아래로 신저점
    if botSt != 0 and not na(botLow) and low < botLow
        botSt := 0
        botLow := na
        botHigh := na
        botStartBar := na

    // 점 1: 하락추세선 상향 돌파
    if brk1_bot and botSt == 0
        botSt := 1
        botLow := dn1
        botHigh := na
        botStartBar := bar_index
        mk(bar_index, low, "1", true, colBot)
        fireBot1 := true

    // 점 2: 직전 저점 재시험 실패 (피벗이 점1 이후에 형성된 경우만 → 순서 보장)
    if botSt == 1 and not na(pl) and not na(botLow) and pl > botLow and (bar_index - n) > botStartBar
        botSt := 2
        botHigh := up1
        mk(bar_index - n, pl, "2", true, colBot)

    // 점 3: 반락 고점 상향 돌파
    if botSt == 2 and not na(botHigh) and botHighBreak
        botSt := 0
        mk(bar_index, low, "3", true, colBot)
        fireBot3 := true
        botLow := na
        botHigh := na
        botStartBar := na

// ================= 2B (신뢰도 필터: 거래량 · ATR 거부꼬리 · 되돌림 신속성) =================
float atrVal = ta.atr(atrLen)
float volSMA = ta.sma(nz(volume), volLen)

var float b2bTop = na
var bool  b2bTopX = false
var int   b2bTopXBar = na

var float b2bBot = na
var bool  b2bBotX = false
var int   b2bBotXBar = na

if show2b
    // 하락형 2B: 직전 고점 경신 후 그 고점 아래로 마감
    if not na(ph)
        b2bTop := ph
        b2bTopX := false
        b2bTopXBar := na

    if not na(b2bTop)
        if high > b2bTop and not b2bTopX
            b2bTopX := true
            b2bTopXBar := bar_index

        if b2bTopX and close < b2bTop
            bool volOK   = not f2bVol   or na(volSMA) or volSMA <= 0 or nz(volume) >= volMult * volSMA
            bool wickOK  = not f2bWick  or (high - math.max(open, close)) >= wickMult * atrVal
            bool freshOK = not f2bFresh or (not na(b2bTopXBar) and bar_index - b2bTopXBar <= b2bMaxBars)
            if volOK and wickOK and freshOK
                mk(bar_index, high, "2B", false, colTop)
                fire2Bbear := true
            b2bTopX := false
            b2bTop := na
            b2bTopXBar := na

    // 상승형 2B: 직전 저점 경신 후 그 저점 위로 마감
    if not na(pl)
        b2bBot := pl
        b2bBotX := false
        b2bBotXBar := na

    if not na(b2bBot)
        if low < b2bBot and not b2bBotX
            b2bBotX := true
            b2bBotXBar := bar_index

        if b2bBotX and close > b2bBot
            bool volOK2   = not f2bVol   or na(volSMA) or volSMA <= 0 or nz(volume) >= volMult * volSMA
            bool wickOK2  = not f2bWick  or (math.min(open, close) - low) >= wickMult * atrVal
            bool freshOK2 = not f2bFresh or (not na(b2bBotXBar) and bar_index - b2bBotXBar <= b2bMaxBars)
            if volOK2 and wickOK2 and freshOK2
                mk(bar_index, low, "2B", true, colBot)
                fire2Bbull := true
            b2bBotX := false
            b2bBot := na
            b2bBotXBar := na

// ---------------- Alerts ----------------
bool firePoint1 = fireTop1 or fireBot1
bool firePoint3 = fireTop3 or fireBot3
bool fireAnySignal = firePoint1 or firePoint3 or fire2Bbear or fire2Bbull

alertcondition(firePoint1, title="Point 1 Trendline Break", message="Sperandeo Point 1: Trendline break")
alertcondition(firePoint3, title="Point 3 Trend Reversal", message="Sperandeo Point 3: trend reversal confirmed")
alertcondition(fire2Bbear, title="2B Bearish Signal", message="2B bearish reversal signal")
alertcondition(fire2Bbull, title="2B Bullish Signal", message="2B bullish reversal signal")
alertcondition(fireAnySignal, title="All Sperandeo Signals", message="Sperandeo 123 or 2B signal occurred")
