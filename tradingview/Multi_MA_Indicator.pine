// 주봉 기준 10주 이동평균
weeklyMA5 = request.security(syminfo.tickerid, "W", ta.ema(close, 5))
plot(weeklyMA5, color=color.rgb(136, 247, 93), linewidth=2, title="주봉 MA5")

weeklyMA10 = request.security(syminfo.tickerid, "W", ta.ema(close, 10))
plot(weeklyMA10, color=color.rgb(245, 235, 100), linewidth=2, title="주봉 MA10")
sma10  = ta.sma(close, 10)
sma20  = ta.sma(close, 20)
sma50  = ta.sma(close, 50)
sma120 = ta.sma(close, 120)
sma240 = ta.sma(close, 240)

plot(sma10,  color=color.rgb(241, 247, 187),  linewidth=1, title="SMA 10")
plot(sma20,  color=color.rgb(245, 58, 58),   linewidth=1, title="SMA 20")
plot(sma50,  color=color.rgb(44, 23, 238),    linewidth=1, title="SMA 50")
plot(sma120, color=color.rgb(203, 51, 230), linewidth=2, title="SMA 120")
plot(sma240, color=color.rgb(226, 224, 85),    linewidth=3, title="SMA 240")


// =========================================================
//  관심종목 10주 EMA 실시간(1분 단위) 크로스 알람
// ---------------------------------------------------------
//  - EMA선은 "주봉" 기준으로 계산 (기본 10주 EMA)
//  - 돌파 판정은 "현재 차트 타임프레임(권장: 1분봉)" 기준
//    → 주 마감을 기다리지 않고 1분마다 재확인, 새 돌파 때마다 재발송
//  - request.security 는 종목당 1회만 사용 (주봉 EMA + 현재가를 tuple로)
//    → 20종목 × 1회 = 20회 (Pine 호출 한도 40 이내)
//  - 알람 설정법 (한 번만):
//      지표 우클릭 → "알림 추가" → 조건에서 "다중 MA" 선택
//      → "Any alert() function call" 선택 → 생성
//    (이 알람 1개로 아래 20종목 전부 커버됩니다)
//  ※ 차트에는 거래가 활발한 종목(예: 삼성전자)을 1분봉으로 띄우세요.
//    스크립트는 차트 종목의 틱이 올 때마다 20종목을 재평가합니다.
// =========================================================
emaLen = input.int(10, "알람 기준 EMA 길이", minval=1)
// EMA선 계산 타임프레임: "W"=주봉 / "D"=일봉
maTF   = input.timeframe("W", "EMA 기준 타임프레임 (기본=주봉)")

// 주봉 EMA + 주봉 진행중 종가(=현재가)를 한 번의 호출로 가져오고,
// 크로스는 현재 차트(1분봉) 기준으로 판정 → 1분 단위 재확인/재발송
f_cross(simple string sym) =>
    [emaW, priceNow] = request.security(sym, maTF, [ta.ema(close, emaLen), close], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    up = ta.crossover(priceNow, emaW)
    dn = ta.crossunder(priceNow, emaW)
    [up, dn, emaW, priceNow]

// 종목별로 검사 후 돌파 시 알람 발송 (1분봉 기준 봉당 최대 1회 → 새 돌파마다 재발송)
f_alert(simple string code, simple string name) =>
    [up, dn, emaW, priceNow] = f_cross("KRX:" + code)
    tag = name == "" ? code : name + "(" + code + ")"
    if up
        alert(tag + " 📈 EMA" + str.tostring(emaLen) + "(" + maTF + ") 상향 돌파" + " / 현재가 " + str.tostring(math.round(priceNow)) + " / EMA " + str.tostring(math.round(emaW)), alert.freq_once_per_bar)
    if dn
        alert(tag + " 📉 EMA" + str.tostring(emaLen) + "(" + maTF + ") 하향 돌파" + " / 현재가 " + str.tostring(math.round(priceNow)) + " / EMA " + str.tostring(math.round(emaW)), alert.freq_once_per_bar)

// ---- 보유 종목 ----
f_alert("005930", "삼성전자")
f_alert("000660", "SK하이닉스")
f_alert("000150", "두산")
f_alert("009150", "삼성전기")
f_alert("122640", "예스티")
f_alert("329180", "HD현대중공업")
f_alert("009540", "HD한국조선해양")
f_alert("095610", "테스")
f_alert("222800", "심텍")
f_alert("240810", "원익IPS")

// ---- 반도체 소부장 ----
f_alert("064290", "인텍플러스")
f_alert("080220", "제주반도체")
f_alert("356860", "")
f_alert("093370", "후성")
f_alert("067310", "하나마이크론")
f_alert("200470", "하이비젼시스템")
f_alert("353200", "대덕전자")
f_alert("281820", "케이씨텍")
f_alert("033160", "엠케이전자")
f_alert("089970", "에이피티씨")
