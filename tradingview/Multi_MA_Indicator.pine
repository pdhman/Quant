// 주봉 기준 10주 이동평균
weeklyMA5 = request.security(syminfo.tickerid, "W", ta.ema(close, 5))
plot(weeklyMA5, color=color.rgb(136, 247, 93), linewidth=2, title="주봉 MA5")

weeklyMA10 = request.security(syminfo.tickerid, "W", ta.ema(close, 10))
plot(weeklyMA10, color=color.rgb(245, 235, 100), linewidth=2, title="주봉 MA10")
sma10  = ta.sma(close, 10)
sma20  = ta.sma(close, 20)
sma50  = ta.sma(close, 50)
sma120 = ta.sma(close, 120)
sma240 = ta.sma(close, 240)

plot(sma10,  color=color.rgb(241, 247, 187),  linewidth=1, title="SMA 10")
plot(sma20,  color=color.rgb(245, 58, 58),   linewidth=1, title="SMA 20")
plot(sma50,  color=color.rgb(44, 23, 238),    linewidth=1, title="SMA 50")
plot(sma120, color=color.rgb(203, 51, 230), linewidth=2, title="SMA 120")
plot(sma240, color=color.rgb(226, 224, 85),    linewidth=3, title="SMA 240")


// =========================================================
//  관심종목 EMA10 크로스 알람
// ---------------------------------------------------------
//  - 아래 관심종목이 EMA10 선을 "종가 기준"으로 돌파하면 알람 발생
//  - 차트에 어떤 종목을 띄워도, 지정한 관심종목 전체를 감시함
//  - 알람 설정법 (한 번만):
//      지표 우클릭 → "알림 추가" → 조건에서 "다중 MA" 선택
//      → "Any alert() function call" 선택 → 생성
//    (이 알람 1개로 아래 20종목 전부 커버됩니다)
// =========================================================
emaLen  = input.int(10, "알람 기준 EMA 길이", minval=1)
// "W"=주봉 / "D"=일봉 / 공백("")=현재 차트 타임프레임
alertTF = input.timeframe("W", "알람 타임프레임 (기본=주봉)")

// 한 종목의 EMA 상향/하향 돌파 여부 + 해당 봉의 시작시간 계산
f_cross(simple string sym) =>
    [u, d, t] = request.security(sym, alertTF, [ta.crossover(close, ta.ema(close, emaLen)), ta.crossunder(close, ta.ema(close, emaLen)), time])
    [u, d, t]

// 종목별로 검사 후 돌파 시 알람 발송
// 같은 봉(주봉)에서는 종목당 1회만 발송 → 주말/휴일에 차트 봉이 새로 생겨도 반복 알람 없음
f_alert(simple string code, simple string name) =>
    [up, dn, barT] = f_cross("KRX:" + code)
    var int lastUpBar = na
    var int lastDnBar = na
    tag = name == "" ? code : name + "(" + code + ")"
    if up and barT != lastUpBar
        alert(tag + " 📈 EMA" + str.tostring(emaLen) + " 상향 돌파", alert.freq_once_per_bar)
        lastUpBar := barT
    if dn and barT != lastDnBar
        alert(tag + " 📉 EMA" + str.tostring(emaLen) + " 하향 돌파", alert.freq_once_per_bar)
        lastDnBar := barT

// ---- 보유 종목 ----
f_alert("005930", "삼성전자")
f_alert("000660", "SK하이닉스")
f_alert("000150", "두산")
f_alert("009150", "삼성전기")
f_alert("122640", "예스티")
f_alert("329180", "HD현대중공업")
f_alert("009540", "HD한국조선해양")
f_alert("095610", "테스")
f_alert("222800", "심텍")
f_alert("240810", "원익IPS")

