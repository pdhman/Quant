//@version=6
// =====================================================================
//  Adaptive Volatility Channel — Strategy (30~60분봉용)
// ---------------------------------------------------------------------
//  · 모든 기간을 '일(day)' 단위로 지정 → 1일 봉 수(barsPerDay)로 봉 수 자동 환산
//    (30분봉 ≈ 13봉/일, 60분봉 ≈ 7봉/일)
//  · 채널 룩백 = 최대 1주(=5거래일), ATR 장기 = 1주, 백분위도 일 단위로 조정
//  진입(모두 '확인 후 다음 봉 시가' 체결):
//    · 돌파(VOLCANO): 종가가 직전 채널을 돌파 + 거래량 > 평균×배수 일 때만 진입
//    · 회귀(STARS):   되돌림 존까지 눌렀다가 종가가 다시 회복(확인)되면 다음 봉 진입
//  청산: 1R 분할 익절 + 본전 이동 / 회귀=중심선 목표·돌파=트레일링 / 단계 트레일링
// =====================================================================
strategy("Adaptive Volatility Channel Strategy", overlay=true,
     initial_capital=10000000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.15, pyramiding=0, calc_on_every_tick=false)

// ---------------- ① 타임프레임 스케일 ----------------
string gTF = "① 타임프레임 (30~60분봉)"
int   barsPerDay = input.int(13, "1일 봉 수 (30분≈13 / 60분≈7)", minval=1, group=gTF, tooltip="KRX 정규장 6.5시간 기준. 30분봉≈13, 60분봉≈7. 이 값으로 아래 '일' 단위 입력을 봉 수로 환산")

// ---------------- ② 변동성 측정 (일 단위) ----------------
string gV = "② 변동성 측정 (일 단위)"
float atrFastDays = input.float(1.0, "ATR 단기 (일)",      minval=0.2, step=0.5, group=gV)
float atrSlowDays = input.float(5.0, "ATR 장기 (일 = 1주)", minval=1.0, step=0.5, group=gV)
float rankDays    = input.float(10.0,"백분위 산출 기간 (일)", minval=1.0, step=1.0, group=gV, tooltip="변동성 비율의 백분위를 산출할 표본 기간. 짧으면 국면 전환이 잦고, 길면 안정적")

// ---------------- ③ 적응형 채널 (일 단위) ----------------
string gC = "③ 적응형 채널 (일 단위)"
float lookMinDays = input.float(2.0, "룩백 최소 (일)",       minval=0.5, step=0.5, group=gC)
float lookMaxDays = input.float(5.0, "룩백 최대 (일 = 1주)", minval=1.0, step=0.5, group=gC)

// ---------------- ④ 국면 ----------------
string gR = "④ 국면 판단"
float volThr = input.float(60, "돌파 모드 임계 백분위(%)", minval=0, maxval=100, step=5, group=gR)

// ---------------- ⑤ 돌파 거래량 필터 ----------------
string gVol = "⑤ 돌파 거래량 필터"
bool  useVol  = input.bool(true, "돌파 진입 시 거래량 필터 사용", group=gVol)
float volMult = input.float(1.5, "거래량 배수 (× 평균)", minval=0.1, step=0.1, group=gVol, tooltip="돌파 봉의 거래량이 평균×이 배수를 초과해야 진입. 회귀(STARS) 진입에는 적용 안 함")
float volDays = input.float(5.0, "거래량 평균 기간 (일)", minval=0.5, step=0.5, group=gVol)

// ---------------- ⑥ 진입 ----------------
string gE = "⑥ 진입"
float  bufMult = input.float(0.5, "STARS 되돌림 존 버퍼 (ATR 배수)", minval=0.0, step=0.25, group=gE, tooltip="채널 끝에서 이 ATR 배수만큼 더 눌렀다가 회복해야 되돌림으로 인정")
float  atrDays = input.float(1.0, "거래 ATR 기간 (일) — 버퍼·손절·트레일 공통", minval=0.2, step=0.5, group=gE)
string dirMode = input.string("롱&숏", "매매 방향", options=["롱only","숏only","롱&숏"], group=gE)

// ---------------- ⑦ 청산 (분할 + 모드별 + 단계 트레일링) ----------------
string gX = "⑦ 청산"
float slMult    = input.float(2.0, "초기 손절 ATR 배수 (=1R)", minval=0.5, step=0.25, group=gX)
float tp1Pct    = input.float(50, "1차 익절 비율 % (1R에서)", minval=0, maxval=100, step=5, group=gX)
float trig1R    = input.float(1.0, "1단계 트레일 시작 (R)", minval=0.1, step=0.25, group=gX)
float trail1Mlt = input.float(3.0, "1단계 트레일 ATR 배수(넓게)", minval=0.5, step=0.25, group=gX)
float trig2R    = input.float(2.0, "2단계 트레일 시작 (R)", minval=0.2, step=0.25, group=gX)
float trail2Mlt = input.float(1.5, "2단계 트레일 ATR 배수(타이트)", minval=0.25, step=0.25, group=gX)

// ---------------- ⑧ 기타 필터 ----------------
string gF = "⑧ 기타"
bool  useDate  = input.bool(false, "기간 제한", group=gF)
int   fromDate = input.time(timestamp("2016-01-01T00:00"), "시작", group=gF)
int   toDate   = input.time(timestamp("2027-01-01T00:00"), "종료", group=gF)
bool  friClose = input.bool(false, "금요일 마감 전 청산(선물용)", group=gF)

// ---------------- 일 → 봉 수 환산 ----------------
int atrFast    = math.max(2,  int(math.round(atrFastDays * barsPerDay)))
int atrSlow    = math.max(3,  int(math.round(atrSlowDays * barsPerDay)))
int rankLen    = math.max(20, int(math.round(rankDays    * barsPerDay)))
int lenMin     = math.max(2,  int(math.round(lookMinDays * barsPerDay)))
int lenMax     = math.max(lenMin + 1, int(math.round(lookMaxDays * barsPerDay)))
int volLen     = math.max(2,  int(math.round(volDays     * barsPerDay)))
int tradeAtr   = math.max(2,  int(math.round(atrDays     * barsPerDay)))

// ---------------- 변동성 & 적응형 채널 ----------------
float volRatio = ta.atr(atrFast) / ta.atr(atrSlow)
float volRank  = ta.percentrank(volRatio, rankLen)
int   lookback = int(math.round(lenMin + (lenMax - lenMin) * nz(volRank, 50) / 100))
float prevHigh = ta.highest(high, math.max(1, lookback))
float prevLow  = ta.lowest(low,  math.max(1, lookback))

color COL_UP = #f23645
color COL_DN = #089981
plot(prevHigh, "채널 상단", color=color.new(COL_UP, 25), linewidth=2)
plot(prevLow,  "채널 하단", color=color.new(COL_DN, 25), linewidth=2)

// ---------------- 국면 ----------------
bool breakoutMode = volRank > volThr
bool meanrevMode  = not breakoutMode
bgcolor(breakoutMode ? color.new(#ff9800, 93) : color.new(#2962ff, 95))

// ---------------- 방향 필터 (원본 방식) ----------------
float lowRet  = (low - low[1]) / low[1]
float highRet = (high - high[1]) / high[1]
float sdLow   = ta.stdev(lowRet,  math.max(2, lookback), false)
float sdHigh  = ta.stdev(highRet, math.max(2, lookback), false)
bool longSide  = sdLow  - sdLow[1]  < 0
bool shortSide = sdHigh - sdHigh[1] < 0

// ---------------- 진입 신호 (확인 후 다음 봉 체결) ----------------
float buffer  = bufMult * ta.atr(tradeAtr)
float refHigh = prevHigh[1]          // 직전 봉 기준 채널(자기참조 방지)
float refLow  = prevLow[1]
float buyZone  = refLow  - buffer
float sellZone = refHigh + buffer

float volMA = ta.sma(volume, volLen)
bool  volOK = not useVol or na(volMA) or volMA <= 0 or volume > volMult * volMA

// 돌파: 종가가 직전 채널을 넘어 마감 + (거래량 확인)
bool brkUp = close > refHigh and volOK
bool brkDn = close < refLow  and volOK
// 회귀: 되돌림 존까지 눌렀다가 종가가 다시 회복(확인)
bool staUp = low  <= buyZone  and close > buyZone
bool staDn = high >= sellZone and close < sellZone

bool longBreak  = breakoutMode and longSide  and brkUp
bool longStar   = meanrevMode  and longSide  and staUp
bool shortBreak = breakoutMode and shortSide and brkDn
bool shortStar  = meanrevMode  and shortSide and staDn

bool longSig  = longBreak  or longStar
bool shortSig = shortBreak or shortStar

bool longOK  = dirMode != "숏only"
bool shortOK = dirMode != "롱only"
bool inRange = not useDate or (time >= fromDate and time <= toDate)

// 금요일 마감 청산(선물용)
bool fridayFlat = friClose and dayofweek == dayofweek.friday and barstate.isconfirmed and hour >= 14
if fridayFlat
    strategy.close_all("주말 청산")

var bool pendingMeanRev = false   // 이번 진입이 회귀(true)/돌파(false)였는지 기록

if strategy.position_size == 0 and inRange and not fridayFlat
    if longSig and longOK
        pendingMeanRev := longStar
        strategy.entry("Long", strategy.long)    // 확인 봉 마감 → 다음 봉 시가 체결
    else if shortSig and shortOK
        pendingMeanRev := shortStar
        strategy.entry("Short", strategy.short)

// ---------------- 청산: 분할 + 모드별 목표 + 단계 트레일링 ----------------
float exATR = ta.atr(tradeAtr)
float mid   = (prevHigh + prevLow) / 2
var float rDist   = na
var float posHi   = na
var float posLo   = na
var float lastStopL = na
var float lastStopS = na
var bool  entryMeanRev = false

float ep = strategy.position_avg_price

// 진입 순간 초기화 (진입 국면 기록)
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    rDist := slMult * exATR
    posHi := high
    lastStopL := ep - rDist
    entryMeanRev := pendingMeanRev
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    rDist := slMult * exATR
    posLo := low
    lastStopS := ep + rDist
    entryMeanRev := pendingMeanRev

// 롱 청산
if strategy.position_size > 0
    posHi := math.max(nz(posHi, high), high)
    float profitR = (close - ep) / rDist
    float stopNow = ep - rDist
    if profitR >= trig1R
        stopNow := math.max(stopNow, ep)                          // 1R → 본전(BE)
        stopNow := math.max(stopNow, posHi - trail1Mlt * exATR)   // 넓은 트레일
    if profitR >= trig2R
        stopNow := math.max(stopNow, posHi - trail2Mlt * exATR)   // 타이트 트레일
    lastStopL := math.max(nz(lastStopL, stopNow), stopNow)        // 절대 완화 금지
    float tp1L       = ep + trig1R * rDist                        // 1차 익절 = 1R
    float runTargetL = entryMeanRev ? mid : na                    // 회귀=중심선, 돌파=트레일만
    strategy.exit("L-TP1", from_entry="Long", qty_percent = tp1Pct, limit = tp1L, stop = lastStopL)
    strategy.exit("L-Run", from_entry="Long", limit = runTargetL, stop = lastStopL)
else
    posHi := na
    lastStopL := na

// 숏 청산
if strategy.position_size < 0
    posLo := math.min(nz(posLo, low), low)
    float profitR = (ep - close) / rDist
    float stopNow = ep + rDist
    if profitR >= trig1R
        stopNow := math.min(stopNow, ep)
        stopNow := math.min(stopNow, posLo + trail1Mlt * exATR)
    if profitR >= trig2R
        stopNow := math.min(stopNow, posLo + trail2Mlt * exATR)
    lastStopS := math.min(nz(lastStopS, stopNow), stopNow)
    float tp1S       = ep - trig1R * rDist
    float runTargetS = entryMeanRev ? mid : na
    strategy.exit("S-TP1", from_entry="Short", qty_percent = tp1Pct, limit = tp1S, stop = lastStopS)
    strategy.exit("S-Run", from_entry="Short", limit = runTargetS, stop = lastStopS)
else
    posLo := na
    lastStopS := na

// 기간 종료 시 전체 청산
if useDate and time > toDate
    strategy.close_all()
